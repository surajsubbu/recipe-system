# ─────────────────────────────────────────────────────────────────────────────
# Recipe System — environment template
#   cp .env.example .env    then fill in every CHANGE_ME value.
#   Never commit .env (it's in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Clerk (login) — dashboard.clerk.com → API Keys ─────────────────────────
# Development keys (sk_test_/pk_test_) work on any domain, including plain
# http on a LAN IP. Production keys require HTTPS on your own domain.
CLERK_SECRET_KEY=CHANGE_ME
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=CHANGE_ME
CLERK_JWKS_URL=https://CHANGE_ME.clerk.accounts.dev/.well-known/jwks.json

# Keep sign-in inside the app (otherwise Clerk sends users to its hosted page)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ─── OpenRouter (AI) — openrouter.ai/keys ───────────────────────────────────
# Model IDs change over time — check openrouter.ai/models if ingestion fails.
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_FAST_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_SMART_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BALANCED_MODEL=google/gemini-2.5-flash

# ─── Passwords — generate with: openssl rand -hex 24 ────────────────────────
# Letters/digits only (it goes into a database URL). POSTGRES_PASSWORD is fixed
# when the database volume is first created — changing it later breaks login.
POSTGRES_PASSWORD=CHANGE_ME
FLOWER_PASSWORD=CHANGE_ME
# Home Assistant webhook — callers send "Authorization: Bearer <value>"
HA_WEBHOOK_SECRET=CHANGE_ME

# ─── Network ────────────────────────────────────────────────────────────────
# The BROWSER calls the backend directly, so this must be an address your
# devices can reach — not localhost unless you only use the server itself.
#   LAN only:            http://<server-ip>:8001
#   Cloudflare tunnel:   https://recipe-api.example.com
NEXT_PUBLIC_BACKEND_URL=http://CHANGE_ME:8001
# Every address the frontend is opened from (comma-separated, no spaces)
CORS_ORIGINS=http://CHANGE_ME:3001,http://localhost:3001

# ─── Speech-to-text for YouTube ─────────────────────────────────────────────
# tiny / base / small / medium / large — base suits servers with ≤8 GB RAM
WHISPER_MODEL_SIZE=base

# ─── Optional services (docker compose --profile optional up -d) ────────────
# Only needed if you run this repo's own cloudflared container
CLOUDFLARE_TUNNEL_TOKEN=
# OLLAMA_MODEL=llama3.2:7b
# N8N_PASSWORD=CHANGE_ME
